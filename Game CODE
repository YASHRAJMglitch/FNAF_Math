static void HealthBar(int currenthealth, int freddyhealth)
{
    int healthcount = 0;
    int freddyhealthcount = 0;
    Console.ForegroundColor = ConsoleColor.White;
    Console.Write("HEALTH : ");

    for (int i = 0; i < currenthealth; i++)
    {
        Console.Write($"\u2588 ");
        healthcount++;
    }
    
    for (; healthcount < 3; healthcount++)
    {
        Console.Write($"\u2591 ");
    }

    Console.Write("\t\t\t\t\t\t\t\t\t\tFreddy Health: ");

    for (int i = 0; i < freddyhealth; i++)
    {
        Console.Write($"\u2588 ");
        freddyhealthcount++;
    }

    for (; freddyhealthcount < 4; freddyhealthcount++)
    {
        Console.Write($"\u2591 ");
    }


    Console.ResetColor();
}

